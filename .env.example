# Variables de la función /api/detonadoras. Cópialo a .env (local, con `vercel dev`)
# o captúralas en Vercel → Settings → Environment Variables.
#
# Ninguna lleva el prefijo VITE_, y nunca debe llevarlo: Vite mete en el bundle del
# navegador toda variable que empiece así, y lo que llega al navegador lo lee cualquiera.

# Model Studio → API Keys, en la región Singapur (la única con cuota gratuita).
DASHSCOPE_API_KEY=

# URL compatible con OpenAI de tu workspace en Singapur, sin /chat/completions al final.
DASHSCOPE_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Fija la versión fechada que muestre la consola en cuanto la elijas con
# `npm run eval:detonadoras`: el alias sin fecha cambia de modelo sin avisar.
QWEN_MODEL=qwen3.8-flash

# json_schema (preferido) o json_object si la región todavía no soporta esquemas.
QWEN_RESPONSE_FORMAT=json_schema

# Orígenes aceptados, separados por comas. Vacío acepta cualquiera: sólo para local.
ALLOWED_ORIGIN=
